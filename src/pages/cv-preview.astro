---
import PageLayout from '@/layouts/BaseLayout.astro'
import cvPreview from '@/assets/cv-preview.webp'
---

<PageLayout meta={{ title: 'CV Preview' }} highlightColor='#7B6FE0'>
  <main class='mx-auto w-full max-w-5xl px-0 pb-16 pt-6 sm:pt-10'>
    <section class='overflow-hidden rounded-3xl border border-border bg-background/95 shadow-2xl'>
      <header
        class='flex flex-wrap items-center justify-between gap-3 border-b border-border px-5 py-4 sm:px-7'
      >
        <div>
          <p class='text-xs font-medium uppercase tracking-[0.18em] text-primary'>
            Private preview
          </p>
          <h1 class='font-serif text-2xl font-semibold'>Curriculum Vitae</h1>
        </div>
        <a
          href='/'
          class='inline-flex items-center rounded-full border border-border bg-muted px-4 py-2 text-sm text-muted-foreground transition-colors hover:text-foreground'
        >
          Back to home
        </a>
      </header>

      <div
        id='cv-preview-loading'
        class='flex min-h-64 items-center justify-center p-8 text-sm text-muted-foreground'
      >
        Verifying access…
      </div>

      <div
        id='cv-preview-viewer'
        class='relative hidden bg-[#111018] p-2 sm:p-5'
        aria-label='CV preview'
      >
        <div class='relative mx-auto max-w-[72rem] overflow-hidden rounded-lg bg-white shadow-2xl'>
          <canvas
            id='cv-preview-canvas'
            data-preview-src={cvPreview.src}
            class='block h-auto w-full select-none'
            aria-label='Samxander curriculum vitae preview'></canvas>
          <div
            class='pointer-events-none absolute bottom-3 right-3 rounded-full bg-black/55 px-3 py-1 text-[10px] font-medium uppercase tracking-widest text-white/75 backdrop-blur-sm sm:bottom-5 sm:right-5'
            aria-hidden='true'
          >
            Preview only · samxander.cn
          </div>
        </div>
      </div>
    </section>
  </main>
</PageLayout>

<script>
  const accessToken = 'cv-preview-9e4185db6b7343b5a206'
  const loading = document.querySelector<HTMLElement>('#cv-preview-loading')
  const viewer = document.querySelector<HTMLElement>('#cv-preview-viewer')
  const canvas = document.querySelector<HTMLCanvasElement>('#cv-preview-canvas')

  const denyAccess = () => window.location.replace('/?cv=locked')

  try {
    const storedAccess = sessionStorage.getItem('cv-preview-access')
    const access = storedAccess ? JSON.parse(storedAccess) : null
    if (access?.token !== accessToken || Number(access?.expiresAt) <= Date.now()) {
      sessionStorage.removeItem('cv-preview-access')
      denyAccess()
    } else if (canvas) {
      const source = canvas.dataset.previewSrc
      if (!source) throw new Error('Preview source unavailable')

      const previewImage = new Image()
      previewImage.decoding = 'async'
      previewImage.onload = () => {
        canvas.width = previewImage.naturalWidth
        canvas.height = previewImage.naturalHeight
        const context = canvas.getContext('2d')
        if (!context) throw new Error('Canvas unavailable')
        context.drawImage(previewImage, 0, 0)
        loading?.classList.add('hidden')
        viewer?.classList.remove('hidden')
      }
      previewImage.onerror = () => {
        if (loading) loading.textContent = 'The preview could not be loaded. Please try again.'
      }
      previewImage.src = source
    }
  } catch {
    sessionStorage.removeItem('cv-preview-access')
    denyAccess()
  }

  viewer?.addEventListener('contextmenu', (event) => event.preventDefault())
  document.addEventListener('keydown', (event) => {
    if ((event.ctrlKey || event.metaKey) && ['p', 's'].includes(event.key.toLowerCase())) {
      event.preventDefault()
    }
  })
</script>

<style>
  @media print {
    #cv-preview-viewer {
      display: none !important;
    }
  }
</style>
