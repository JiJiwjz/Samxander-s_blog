---
import AwardCard from '@/components/honors/AwardCard.astro'
import PageLayout from '@/layouts/CommonPage.astro'
import { honors } from '@/data/honors'

const headings = honors.map((honor) => ({ depth: 2, slug: honor.slug, text: honor.title }))
---

<PageLayout title='Honors' {headings} comment>
  <p>A selection of awards from robotics, mathematical modeling, engineering, and cybersecurity competitions.</p>
  <div class='not-prose mt-8 flex flex-col gap-y-6'>
    {honors.map((honor) => <AwardCard {honor} />)}
  </div>
</PageLayout>
