---
import PageLayout from '@/layouts/CommonPage.astro'
import ProjectCard from '@/components/projects/ProjectCard.astro'
import { projects } from '@/data/projects'

const headings = projects.map((project) => ({ depth: 2, slug: project.slug, text: project.title }))
---

<PageLayout title='Projects' {headings} view>
  <p>Selected robotics and intelligent systems projects. Click a project to view its details.</p>
  <div class='not-prose mt-8 flex flex-col gap-y-6'>
    {projects.map((project) => <ProjectCard {project} />)}
  </div>
</PageLayout>
