---
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'

import { Quote } from 'astro-pure/advanced'
import { getBlogCollection, sortMDByDate } from 'astro-pure/server'
import { Button, Card, Icon, Label } from 'astro-pure/user'
import lunarRobotPhoto from '@/assets/lunar-robot.avif'
import nwpuLogo from '@/assets/nwpu.png'
import rescuePhoto from '@/assets/rescue.avif'
import robocupPhoto from '@/assets/robocup.jpg'
import zhongguancunAcademyLogo from '@/assets/zhongguancun-academy.png'
import PageLayout from '@/layouts/BaseLayout.astro'
import Section from '@/components/home/Section.astro'
import SkillLayout from '@/components/home/SkillLayout.astro'
import config from '@/site-config'

const languages = ['C++', 'Python']
const framework = ['Pytorch', 'OpenCV', 'ROS']
const research = ['Image Restoration', 'Robotics']
const projectPlaceholders = [
  { title: 'FIRA 5v5 Soccer Robot' },
  {
    title: 'Lingshu Intelligent Control',
    description: 'Person in Charge, NPU Peak Experience Program'
  }
]

const MAX_POSTS = 10
const allPosts = (await getBlogCollection()) as CollectionEntry<'blog'>[]
const allPostsByDate = sortMDByDate(allPosts).slice(0, MAX_POSTS) as CollectionEntry<'blog'>[]

const imagePath = config.logo.src
const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/*.{jpeg,jpg,png,gif,avif,webp}'
)
if (!images[imagePath])
  throw new Error(
    `"${imagePath}" does not exist in glob: "src/assets/*.{jpeg,jpg,png,gif,avif,webp}"`
  )
---

<PageLayout meta={{ title: 'Home' }} highlightColor='#659EB9'>
  <main class='flex w-full flex-col items-center'>
    <section class='animate mb-10 flex flex-col items-center gap-y-7' id='content-header'>
      <Image
        src={images[imagePath]()}
        alt={config.logo.alt || 'Profile'}
        class='h-28 w-auto rounded-full border p-1'
        loading='eager'
        fetchpriority='high'
      />

      <div class='flex flex-col items-center gap-y-4'>
        <h1 class='text-3xl font-medium'>{config.author}</h1>
        <div class='flex flex-wrap justify-center gap-x-7 gap-y-3'>
          <Label title="Xi'an, ShaanXi">
            <Icon name='location' class='size-5' slot='icon' />
          </Label>
          <Label
            title='Github Homepage'
            as='a'
            href='https://github.com/JiJiwjz'
            target='_blank'
          >
            <Icon name='github' class='size-5' slot='icon' />
          </Label>
        </div>
      </div>
    </section>

    <div id='content' class='animate flex flex-col gap-y-10 md:w-4/5 lg:w-5/6'>
      <Section title='About'>
        <p class='text-muted-foreground'>Undergraduate Student · Low-level Vision · Robotics</p>
        <p class='text-muted-foreground'>
          Hi, I'm Samxander, a sophomore in Artificial Intelligence at <strong>Northwestern Polytechnical University (NWPU)</strong>.
        </p>
        <p class='text-muted-foreground'>
          My research focuses on <strong>Low-level Vision</strong>, currently on <strong>All-in-One Image Restoration</strong> —
          recovering clean images under unknown and compositional degradations with a single unified
          model.
        </p>
        <p class='text-muted-foreground'>
          I also work on <strong>Robotics</strong>. As a member of the Rescue Group at <strong>NWPU's Dance Robot Base</strong>, I am
          responsible for the manipulator subsystem. Our team won <strong>1 championships</strong> and 3 cups at
          <strong>RoboCup China 2026</strong>.
        </p>
        <p class='text-muted-foreground'>
          This site collects my paper notes, technical write-ups, and occasional writing on unrelated
          subjects.
        </p>
        <Button title='More about me' class='w-fit self-end' href='/about' variant='ahead' />
      </Section>
      {
        allPostsByDate.length > 0 && (
          <Section title='Posts'>
            <div class='grid grid-cols-1 gap-4'>
              {allPostsByDate.map((p) => (
                <a
                  href={`/blog/${p.id}`}
                  class='group relative isolate overflow-hidden rounded-2xl border bg-muted px-5 py-3 transition-all hover:border-foreground/25 hover:shadow-sm'
                >
                  {
                    p.data.heroImage && (
                      <>
                        <Image
                          alt={p.data.heroImage.alt || p.data.title}
                          class='absolute inset-y-0 right-0 z-0 hidden h-full w-[48%] object-cover opacity-75 transition duration-500 group-hover:scale-105 sm:block'
                          loading='lazy'
                          style='mask-image:linear-gradient(to right,transparent,black);-webkit-mask-image:linear-gradient(to right,transparent,black)'
                          {...p.data.heroImage}
                        />
                      </>
                    )
                  }
                  <div class='relative z-20 flex flex-col gap-y-2 sm:pr-[50%]'>
                    <div class='flex items-center justify-between gap-x-2'>
                      <span class='line-clamp-1 font-medium group-hover:text-primary transition-colors'>
                        {p.data.title}
                      </span>
                      <span class='shrink-0 text-xs text-muted-foreground'>
                        {p.data.publishDate?.toLocaleDateString(config.locale.dateLocale, config.locale.dateOptions)}
                      </span>
                    </div>
                    {p.data.description && (
                      <p class='line-clamp-2 text-sm text-muted-foreground'>
                        {p.data.description}
                      </p>
                    )}
                    {p.data.tags.length > 0 && (
                      <div class='flex flex-wrap gap-1.5'>
                        {p.data.tags.slice(0, 3).map((tag) => (
                          <span class='rounded-full bg-muted px-2 py-0.5 text-xs text-muted-foreground'>
                            {tag}
                          </span>
                        ))}
                      </div>
                    )}
                  </div>
                </a>
              ))}
            </div>
            <Button title='More posts' class='w-fit self-end' href='/blog' variant='ahead' />
          </Section>
        )
      }

      {
        /* <Section title='Experience'>
      <Card
        heading='Lorem Ipsum'
        subheading='Sit amet consectetur'
        date='Dec 2022 - Nov 2023'
        imagePath='/src/assets/about-astro.png'
        altText='Lorem, ipsum dolor sit'
        imageClass='h-12 w-auto md:-start-16'
      >
        <ul class='ms-4 list-disc text-muted-foreground'>
          <li>
            Lorem, ipsum dolor sit amet consectetur adipisicing elit. Dolore debitis recusandae, ut
            molestiae laboriosam pariatur!

            <li>Lorem ipsum dolor sit amet consectetur adipisicing elit. Molestiae, pariatur!</li>
          </li>
        </ul>
      </Card>
      <Card
        heading='Lorem Ipsum'
        subheading='Sit amet consectetur'
        date='Dec 2022 - Nov 2023'
        imagePath='/src/assets/about-astro.png'
        altText='Lorem, ipsum dolor sit'
        imageClass='h-12 w-auto md:-start-16'
      />
    </Section> */
      }
      <Section title='Education'>
        <Card
          as='a'
          heading='Northwestern Polytechnical University'
          subheading='Undergraduate, Artificial Intelligence, the School of Computer Science'
          date='September 2024 - Now'
          href='https://www.nwpu.edu.cn/'
          class='pr-28'
        >
          <Image
            src={nwpuLogo}
            alt='Northwestern Polytechnical University logo'
            class='absolute right-5 top-1/2 size-16 -translate-y-1/2 object-contain'
          />
        </Card>
        <Card
          heading='Zhongguancun Academy'
          subheading='Visiting Student, Embodied AI, AI Core'
          date='July 2026 - Now'
          class='pr-48'
        >
          <Image
            src={zhongguancunAcademyLogo}
            alt='Zhongguancun Academy logo'
            class='absolute right-5 top-1/2 h-10 w-36 -translate-y-1/2 object-contain'
          />
        </Card>
      </Section>

      <Section title='Projects'>
        <article class='not-prose grid overflow-hidden rounded-2xl border bg-muted sm:min-h-48 sm:grid-cols-[16rem_minmax(0,1fr)]'>
          <Image
            src={rescuePhoto}
            alt='NPU Dancing Robot Base Rescue Team'
            class='aspect-video w-full object-cover sm:aspect-auto sm:h-full'
          />
          <div class='flex flex-col justify-center gap-y-1.5 px-5 py-4'>
            <h2 class='text-lg font-medium'>Rescue Team - NPU Dancing Robot Base</h2>
            <p class='text-muted-foreground'>
              Mission: Locate and mark victims distributed across a simulated disaster environment.
            </p>
            <p class='text-muted-foreground'>
              I am primarily responsible for manipulator software control. I developed
              MoveIt-based semi-autonomous arm control and implemented fully autonomous grasping
              through pose estimation, visual servoing, and inverse kinematics.
            </p>
            <p class='text-muted-foreground'>
              Website: <a
                href='https://dance-robot-base.github.io/'
                target='_blank'
                rel='noopener noreferrer'
                class='text-primary hover:underline'
              >Dancing Robot Base official website</a>
            </p>
          </div>
        </article>
        <article class='not-prose grid overflow-hidden rounded-2xl border bg-muted sm:min-h-48 sm:grid-cols-[16rem_minmax(0,1fr)]'>
          <Image
            src={lunarRobotPhoto}
            alt='Lunar Robot Team Leader'
            class='aspect-video w-full object-cover sm:aspect-auto sm:h-full'
          />
          <div class='flex flex-col justify-center gap-y-1.5 px-5 py-4'>
            <h2 class='text-lg font-medium'>Lunar Robot Team Leader</h2>
            <p class='text-muted-foreground'>
              Mission: Autonomously navigate, identify minerals, and perform robotic-arm sampling
              tasks in a simulated lunar environment.
            </p>
            <p class='text-muted-foreground'>
              My responsibilities included building the vision pipeline, autonomous navigation, and
              robotic-arm grasping.
            </p>
            <p class='text-muted-foreground'>
              GitHub: <a
                href='https://github.com/JiJiwjz/Intelligent-Unmanned-Base'
                target='_blank'
                rel='noopener noreferrer'
                class='text-primary hover:underline'
              >Intelligent Unmanned Base</a>
            </p>
          </div>
        </article>
        {
          projectPlaceholders.map(({ title, description }) => (
            <article class='not-prose grid overflow-hidden rounded-2xl border bg-muted sm:min-h-48 sm:grid-cols-[16rem_minmax(0,1fr)]'>
              <div aria-hidden='true' class='aspect-video bg-card sm:aspect-auto sm:h-full'></div>
              <div class='flex flex-col justify-center gap-y-1.5 px-5 py-4'>
                <h2 class='text-lg font-medium'>{title}</h2>
                {description && <p class='text-muted-foreground'>{description}</p>}
              </div>
            </article>
          ))
        }
      </Section>

      <Section title='Honors'>
        <article class='not-prose grid overflow-hidden rounded-2xl border bg-muted sm:min-h-48 sm:grid-cols-[16rem_minmax(0,1fr)]'>
          <Image
            src={robocupPhoto}
            alt='RoboCup rescue robot and championship trophies'
            class='aspect-video w-full object-cover sm:aspect-auto sm:h-full'
          />
          <div class='flex flex-col justify-center gap-y-1.5 px-5 py-4'>
            <h2 class='text-lg font-medium'>RoboCup China 2026</h2>
            <p class='text-muted-foreground'>
              <strong>National Champion</strong>, RoboCup Rescue Robot League - Dexterous Manipulation Challenge
            </p>
            <p class='text-muted-foreground'>
              <strong>Runner-up</strong>, Rescue Group
            </p>
            <p class='text-muted-foreground'>May 2026</p>
          </div>
        </article>
      </Section>

      <Section title='Skills'>
        <SkillLayout title='Languages' skills={languages} />
        <SkillLayout title='Framework' skills={framework} />
        <SkillLayout title='Research' skills={research} />
      </Section>
    </div>
    <Quote class='mt-12' />
  </main>
</PageLayout>
