---
import { Image } from 'astro:assets'
import { selectedHonors } from '@/data/honors'
import { projects } from '@/data/projects'

import { Quote } from 'astro-pure/advanced'
import { Button, Card } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import Section from '@/components/home/Section.astro'
import Sidebar from '@/components/home/Sidebar.astro'
import AwardCard from '@/components/honors/AwardCard.astro'
import ProjectCard from '@/components/projects/ProjectCard.astro'
import ShowcaseCard from '@/components/projects/ShowcaseCard.astro'
import nwpuLogo from '@/assets/nwpu.png'
import r3Method from '@/assets/r3-method.png'
import zhongguancunAcademyLogo from '@/assets/zhongguancun-academy.png'
import config from '@/site-config'

const languages = ['C++', 'Python']
const framework = ['Pytorch', 'OpenCV', 'ROS']
const research = ['Image Restoration', 'Robotics']

const sidebarSkills = [
  { title: 'Languages', skills: languages },
  { title: 'Framework', skills: framework },
  { title: 'Research', skills: research }
]

const imagePath = config.logo.src
const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/*.{jpeg,jpg,png,gif,avif,webp}'
)
if (!images[imagePath])
  throw new Error(
    `"${imagePath}" does not exist in glob: "src/assets/*.{jpeg,jpg,png,gif,avif,webp}"`
  )
const avatarModule = await images[imagePath]()
const avatar = avatarModule.default
---

<PageLayout meta={{ title: 'Home' }} highlightColor='#7B6FE0' data-home>
  <main class='lg:grid lg:grid-cols-[19rem_minmax(0,1fr)] lg:gap-12'>
    <Sidebar
      avatar={avatar}
      name={config.author}
      subtitle='Undergraduate · AI @ NWPU'
      status='Seeking visiting research / internship opportunities'
      location="Xi'an, ShaanXi"
      emails={['weijiazhe123@mail.nwpu.edu.cn']}
      contacts={[
        { label: 'GitHub', href: 'https://github.com/JiJiwjz', icon: 'github' },
        { label: '知乎', href: 'https://www.zhihu.com/people/shuai-xiao-ji-65', icon: 'zhihu' },
        {
          label: '小红书',
          href: 'https://www.xiaohongshu.com/user/profile/61e4cf3900000000210232c4',
          icon: 'coolapk'
        }
      ]}
      cvUrl='/cv-preview'
      skills={sidebarSkills}
    />

    <div id='content' class='animate flex flex-col gap-y-12'>
      <Section title='About' layout='top'>
        <p class='text-muted-foreground'>Undergraduate Student · Low-level Vision · Robotics</p>
        <p class='text-muted-foreground'>
          Hi, I'm Samxander, a junior in Artificial Intelligence at <strong
            >Northwestern Polytechnical University (NWPU)</strong
          >.
        </p>
        <p class='text-muted-foreground'>
          My research focuses on <strong>Low-level Vision</strong>, currently on <strong
            >All-in-One Image Restoration</strong
          > — recovering clean images under unknown and compositional degradations with a single unified
          model.
        </p>
        <p class='text-muted-foreground'>
          I also work on <strong>Robotics</strong>. As a member of the Rescue Group at <strong
            >NWPU's Dance Robot Base</strong
          >, I am responsible for the manipulator subsystem. Our team won <strong
            >1 championship and 3 runner-up cups</strong
          > at
          <strong>RoboCup China 2026</strong>.
        </p>
        <Button title='More about me' class='w-fit self-end' href='/about' variant='ahead' />
      </Section>
      <div id='papers' class='scroll-mt-24'>
        <Section title='Papers' layout='top'>
          <ShowcaseCard
            id='r3'
            heading='h3'
            layout='landscape'
            title='R³: Region-Relation Reasoning for All-in-One Image Restoration'
            links={[
              { label: 'Paper', icon: 'document' },
              { label: 'Website', icon: 'earth' },
              { label: 'Code', icon: 'github' }
            ]}
          >
            <a slot='cover' href={r3Method.src} target='_blank' rel='noopener noreferrer'
              aria-label='View full-size R³ method diagram'
              class='block cursor-zoom-in focus-visible:outline-offset-[-3px]'>
              <Image src={r3Method} alt='R³ perception and restoration stages connected by a region relation graph'
                widths={[256, 384, 576, 960]} sizes='(min-width: 640px) min(36vw, 16rem), calc(100vw - 4rem)'
                loading='lazy' class='block h-auto w-full' />
            </a>
            <p class='text-sm leading-relaxed text-muted-foreground'>
              <strong class='whitespace-nowrap font-bold text-foreground underline underline-offset-2'>Jiazhe Wei</strong>,
              Kangbiao Shi, Pengwei Zhang, Wei Dong, Haofei Qian, Peng Wu, Axi Niu, Qingsen Yan<sup>†</sup>
            </p>
          </ShowcaseCard>
        </Section>
      </div>

      <Section title='Education' layout='top'>
        <Card
          as='a'
          heading='Northwestern Polytechnical University'
          subheading='Undergraduate, Artificial Intelligence, the School of Computer Science'
          date='September 2024 - Now'
          href='https://www.nwpu.edu.cn/'
          class='pr-28'
        >
          <Image
            src={nwpuLogo}
            alt='Northwestern Polytechnical University logo'
            class='edu-logo-nwpu absolute right-5 top-1/2 size-16 -translate-y-1/2 object-contain'
          />
        </Card>
        <Card
          heading='Zhongguancun Academy'
          subheading='Visiting Student, Embodied AI, AI Core'
          date='July 2026 - Now'
          class='pr-48'
        >
          <Image
            src={zhongguancunAcademyLogo}
            alt='Zhongguancun Academy logo'
            class='edu-logo-zgc absolute right-5 top-1/2 h-10 w-36 -translate-y-1/2 object-contain'
          />
        </Card>
      </Section>

      <Section title='Projects' layout='top'>
        {projects.map((project) => <ProjectCard {project} />)}
      </Section>

      <Section title='Selected Awards and Honors' layout='top'>
        {selectedHonors.map((honor) => <AwardCard {honor} />)}
        <Button title='More Honors' class='w-fit self-end' href='/honors' variant='ahead' />
      </Section>

      <Quote />
    </div>
  </main>
</PageLayout>

<style is:global>
  html.dark body[data-home] {
    --foreground: 260 54.5% 95.7%;
    --muted-foreground: 257.1 20.6% 86.7%;
    --strong: 253.3 100% 87.6%;
    --background: 217.5 41% 15.3%;
    background-image:
      radial-gradient(ellipse 79% 125% at 14% 0%, #524367, transparent 82%),
      linear-gradient(135deg, #2e314e 15%, #172337 83%);
    background-attachment: fixed;
  }

  html.dark body[data-home] #highlight-gradient {
    display: none;
  }

  html.dark body[data-home] #sidebar {
    --card-bg: 245.7 20.4% 20.2%;
    --card-fg: var(--foreground);
    --card-muted: 253.3 18.4% 80.8%;
    --card-border: 253.6 14.3% 30.2%;
    --card-link: var(--strong);
  }
</style>
