---
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'

import { Quote } from 'astro-pure/advanced'
import { getBlogCollection, sortMDByDate } from 'astro-pure/server'
import { Button, Card, Icon } from 'astro-pure/user'
import firaSoccerRobotPhoto from '@/assets/fira-soccer-robot.avif'
import lingshuIntelligentControlPhoto from '@/assets/lingshu-intelligent-control.avif'
import lunarRobotPhoto from '@/assets/lunar-robot.avif'
import nwpuLogo from '@/assets/nwpu.png'
import rescuePhoto from '@/assets/rescue.avif'
import robocupPhoto from '@/assets/robocup.avif'
import zhongguancunAcademyLogo from '@/assets/zhongguancun-academy.png'
import PageLayout from '@/layouts/BaseLayout.astro'
import Section from '@/components/home/Section.astro'
import Sidebar from '@/components/home/Sidebar.astro'
import config from '@/site-config'

const languages = ['C++', 'Python']
const framework = ['Pytorch', 'OpenCV', 'ROS']
const research = ['Image Restoration', 'Robotics']

const sidebarSkills = [
  { title: 'Languages', skills: languages },
  { title: 'Framework', skills: framework },
  { title: 'Research', skills: research },
]

const MAX_POSTS = 10
const allPosts = (await getBlogCollection()) as CollectionEntry<'blog'>[]
const allPostsByDate = sortMDByDate(allPosts).slice(0, MAX_POSTS) as CollectionEntry<'blog'>[]

const imagePath = config.logo.src
const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/*.{jpeg,jpg,png,gif,avif,webp}'
)
if (!images[imagePath])
  throw new Error(
    `"${imagePath}" does not exist in glob: "src/assets/*.{jpeg,jpg,png,gif,avif,webp}"`
  )
const avatarModule = await images[imagePath]()
const avatar = avatarModule.default
---

<PageLayout meta={{ title: 'Home' }} highlightColor='#7B6FE0'>
  <main class='lg:grid lg:grid-cols-[19rem_minmax(0,1fr)] lg:gap-12'>
    <Sidebar
      avatar={avatar}
      name={config.author}
      subtitle='Undergraduate · AI @ NWPU'
      status='Seeking visiting research / internship opportunities'
      location="Xi'an, ShaanXi"
      emails={['weijiazhe123@mail.nwpu.edu.cn']}
      contacts={[
        { label: 'GitHub', href: 'https://github.com/JiJiwjz', icon: 'github' },
        { label: '知乎', href: 'https://www.zhihu.com/people/shuai-xiao-ji-65', icon: 'zhihu' },
        {
          label: '小红书',
          href: 'https://www.xiaohongshu.com/user/profile/61e4cf3900000000210232c4',
          icon: 'coolapk'
        }
      ]}
      cvUrl='/cv.pdf'
      skills={sidebarSkills}
    />

    <div id='content' class='animate flex flex-col gap-y-12'>
      <Section title='About' layout='top'>
        <p class='text-muted-foreground'>Undergraduate Student · Low-level Vision · Robotics</p>
        <p class='text-muted-foreground'>
          Hi, I'm Samxander, a sophomore in Artificial Intelligence at <strong>Northwestern Polytechnical University (NWPU)</strong>.
        </p>
        <p class='text-muted-foreground'>
          My research focuses on <strong>Low-level Vision</strong>, currently on <strong>All-in-One Image Restoration</strong> —
          recovering clean images under unknown and compositional degradations with a single unified
          model.
        </p>
        <p class='text-muted-foreground'>
          I also work on <strong>Robotics</strong>. As a member of the Rescue Group at <strong>NWPU's Dance Robot Base</strong>, I am
          responsible for the manipulator subsystem. Our team won <strong>1 championship and 3 runner-up cups</strong> at
          <strong>RoboCup China 2026</strong>.
        </p>
        <p class='text-muted-foreground'>
          This site collects my paper notes, technical write-ups, and occasional writing on unrelated
          subjects.
        </p>
        <Button title='More about me' class='w-fit self-end' href='/about' variant='ahead' />
      </Section>
      {
        allPostsByDate.length > 0 && (
          <Section title='Posts' layout='top'>
            <div class='grid grid-cols-1 gap-4'>
              {allPostsByDate.map((p) => (
                <a
                  href={`/blog/${p.id}`}
                  class='group relative isolate overflow-hidden rounded-2xl border bg-muted px-5 py-3 transition-all hover:border-foreground/25 hover:shadow-sm'
                >
                  {
                    p.data.heroImage && (
                      <>
                        <Image
                          alt={p.data.heroImage.alt || p.data.title}
                          class='absolute inset-y-0 right-0 z-0 hidden h-full w-[42%] object-cover opacity-75 transition duration-500 group-hover:scale-105 sm:block'
                          loading='lazy'
                          style='mask-image:linear-gradient(to right,transparent,black);-webkit-mask-image:linear-gradient(to right,transparent,black)'
                          {...p.data.heroImage}
                        />
                      </>
                    )
                  }
                  <div class='relative z-20 flex flex-col gap-y-2 sm:pr-[44%]'>
                    <div class='flex items-center justify-between gap-x-2'>
                      <span class='line-clamp-1 font-medium group-hover:text-primary transition-colors'>
                        {p.data.title}
                      </span>
                      <span class='shrink-0 text-xs text-muted-foreground'>
                        {p.data.publishDate?.toLocaleDateString(config.locale.dateLocale, config.locale.dateOptions)}
                      </span>
                    </div>
                    {p.data.description && (
                      <p class='line-clamp-2 text-sm text-muted-foreground'>
                        {p.data.description}
                      </p>
                    )}
                    {p.data.tags.length > 0 && (
                      <div class='flex flex-wrap gap-1.5'>
                        {p.data.tags.slice(0, 3).map((tag) => (
                          <span class='rounded-full bg-muted px-2 py-0.5 text-xs text-muted-foreground'>
                            {tag}
                          </span>
                        ))}
                      </div>
                    )}
                  </div>
                </a>
              ))}
            </div>
            <Button title='More posts' class='w-fit self-end' href='/blog' variant='ahead' />
          </Section>
        )
      }

      <Section title='Education' layout='top'>
        <Card
          as='a'
          heading='Northwestern Polytechnical University'
          subheading='Undergraduate, Artificial Intelligence, the School of Computer Science'
          date='September 2024 - Now'
          href='https://www.nwpu.edu.cn/'
          class='pr-28'
        >
          <Image
            src={nwpuLogo}
            alt='Northwestern Polytechnical University logo'
            class='edu-logo-nwpu absolute right-5 top-1/2 size-16 -translate-y-1/2 object-contain'
          />
        </Card>
        <Card
          heading='Zhongguancun Academy'
          subheading='Visiting Student, Embodied AI, AI Core'
          date='July 2026 - Now'
          class='pr-48'
        >
          <Image
            src={zhongguancunAcademyLogo}
            alt='Zhongguancun Academy logo'
            class='edu-logo-zgc absolute right-5 top-1/2 h-10 w-36 -translate-y-1/2 object-contain'
          />
        </Card>
      </Section>

      <Section title='Projects' layout='top'>
        <article class='not-prose flex gap-x-5 border-b border-border pb-6 last:border-b-0 last:pb-0 sm:min-h-[15.75rem] sm:items-center sm:gap-x-6'>
          <img
            src={rescuePhoto.src}
            alt='NPU Dancing Robot Base Rescue Team'
            width={rescuePhoto.width}
            height={rescuePhoto.height}
            loading='lazy'
            decoding='async'
            class='aspect-square w-32 shrink-0 rounded-lg border border-border object-cover sm:w-48'
          />
          <div class='flex min-w-0 flex-col justify-center gap-y-1.5'>
            <h2 class='font-serif text-lg font-semibold'>Rescue Team - NPU Dancing Robot Base</h2>
            <p class='text-muted-foreground'>
              Mission: Locate and mark victims distributed across a simulated disaster environment.
            </p>
            <p class='text-muted-foreground'>
              I am primarily responsible for manipulator software control. I developed
              MoveIt-based semi-autonomous arm control and implemented fully autonomous grasping
              through pose estimation, visual servoing, and inverse kinematics.
            </p>
            <a
              href='https://dance-robot-base.github.io/'
              target='_blank'
              rel='noopener noreferrer'
              title='Dancing Robot Base official website'
              class='mt-1 inline-flex w-fit items-center gap-x-1.5 rounded-lg border border-border bg-background px-3 py-1.5 text-sm font-medium text-muted-foreground shadow-sm transition-colors hover:border-foreground/25 hover:text-foreground'
            >
              <Icon name='earth' class='size-4' />
              Website
            </a>
          </div>
        </article>
        <article class='not-prose flex gap-x-5 border-b border-border pb-6 last:border-b-0 last:pb-0 sm:min-h-[15.75rem] sm:items-center sm:gap-x-6'>
          <img
            src={lunarRobotPhoto.src}
            alt='Lunar Robot Team Leader - Intelligent Unmanned Base'
            width={lunarRobotPhoto.width}
            height={lunarRobotPhoto.height}
            loading='lazy'
            decoding='async'
            class='aspect-square w-32 shrink-0 rounded-lg border border-border object-cover sm:w-48'
          />
          <div class='flex min-w-0 flex-col justify-center gap-y-1.5'>
            <h2 class='flex flex-wrap items-center gap-x-2 font-serif text-lg font-semibold'>
              Lunar Robot - Intelligent Unmanned Base
              <span class='rounded-full bg-[hsl(var(--strong)/0.12)] px-2 py-0.5 font-sans text-xs font-medium text-[hsl(var(--strong))]'>
                Team Leader
              </span>
            </h2>
            <p class='text-muted-foreground'>
              Mission: Autonomously navigate, identify minerals, and perform robotic-arm sampling
              tasks in a simulated lunar environment.
            </p>
            <p class='text-muted-foreground'>
              My responsibilities included building the vision pipeline, autonomous navigation, and
              robotic-arm grasping.
            </p>
            <a
              href='https://github.com/JiJiwjz/Intelligent-Unmanned-Base'
              target='_blank'
              rel='noopener noreferrer'
              title='Intelligent Unmanned Base'
              class='mt-1 inline-flex w-fit items-center gap-x-1.5 rounded-lg border border-border bg-background px-3 py-1.5 text-sm font-medium text-muted-foreground shadow-sm transition-colors hover:border-foreground/25 hover:text-foreground'
            >
              <Icon name='github' class='size-4' />
              GitHub
            </a>
          </div>
        </article>
        <article class='not-prose flex gap-x-5 border-b border-border pb-6 last:border-b-0 last:pb-0 sm:min-h-[15.75rem] sm:items-center sm:gap-x-6'>
          <img
            src={firaSoccerRobotPhoto.src}
            alt='FIRA 5v5 Soccer Robot'
            width={firaSoccerRobotPhoto.width}
            height={firaSoccerRobotPhoto.height}
            loading='lazy'
            decoding='async'
            class='aspect-square w-32 shrink-0 rounded-lg border border-border object-cover sm:w-48'
          />
          <div class='flex min-w-0 flex-col justify-center gap-y-1.5'>
            <h2 class='flex flex-wrap items-center gap-x-2 font-serif text-lg font-semibold'>
              FIRA 5v5 Soccer Robot
              <span class='rounded-full bg-[hsl(var(--strong)/0.12)] px-2 py-0.5 font-sans text-xs font-medium text-[hsl(var(--strong))]'>
                Team Leader
              </span>
            </h2>
            <p class='text-muted-foreground'>
              Mission: Coordinate five soccer robots in a match through vision calibration,
              color-based recognition, serial communication, and low-level control.
            </p>
            <p class='text-muted-foreground'>
              My work: Optimized the vision calibration pipeline and multi-robot coordination
              algorithms.
            </p>
            <p class='text-muted-foreground'>Result: Second Prize.</p>
          </div>
        </article>
        <article class='not-prose flex gap-x-5 border-b border-border pb-6 sm:min-h-[15.75rem] sm:items-center sm:gap-x-6'>
          <img
            src={lingshuIntelligentControlPhoto.src}
            alt='Lingshu Intelligent Control'
            width={lingshuIntelligentControlPhoto.width}
            height={lingshuIntelligentControlPhoto.height}
            loading='lazy'
            decoding='async'
            class='aspect-square w-32 shrink-0 rounded-lg border border-border object-cover sm:w-48'
          />
          <div class='flex min-w-0 flex-col justify-center gap-y-1.5'>
            <h2 class='font-serif text-lg font-semibold'>Lingshu Intelligent Control</h2>
            <p class='text-muted-foreground'>Project Lead, NPU Peak Experience Program</p>
            <p class='text-muted-foreground'>
              Under the supervision of <a
                href='https://teacher.nwpu.edu.cn/binzhao.html'
                target='_blank'
                rel='noopener noreferrer'
                class='text-primary hover:underline'
              >Prof. Bin Zhao</a>.
            </p>
          </div>
        </article>
      </Section>

      <Section title='Honors' layout='top'>
        <article class='not-prose flex gap-x-5 border-b border-border pb-6 last:border-b-0 last:pb-0 sm:min-h-[15.75rem] sm:items-center sm:gap-x-6'>
          <img
            src={robocupPhoto.src}
            alt='RoboCup rescue robot and championship trophies'
            width={robocupPhoto.width}
            height={robocupPhoto.height}
            loading='lazy'
            decoding='async'
            class='aspect-square w-32 shrink-0 rounded-lg border border-border object-cover sm:w-48'
          />
          <div class='flex min-w-0 flex-col justify-center gap-y-1.5'>
            <h2 class='font-serif text-lg font-semibold'>RoboCup China 2026</h2>
            <p class='text-muted-foreground'>
              <strong>National Champion</strong>, RoboCup Rescue Robot League - Dexterous Manipulation Challenge
            </p>
            <p class='text-muted-foreground'>
              <strong>Runner-up</strong>, Rescue Group
            </p>
            <p class='text-muted-foreground'>May 2026</p>
          </div>
        </article>
      </Section>

      <Quote />
    </div>
  </main>
</PageLayout>
