---
import { Image } from 'astro:assets'
import { Icon } from 'astro-pure/user'
import type { Project } from '@/data/projects'

interface Props {
  project: Project
}

const { project } = Astro.props
---

<article class='group not-prose relative flex gap-x-5 overflow-hidden rounded-2xl border border-border bg-muted/20 p-4 shadow-sm transition-[transform,border-color,box-shadow] duration-300 ease-out hover:-translate-y-0.5 hover:border-[hsl(var(--strong)/0.3)] hover:shadow-lg hover:shadow-[hsl(var(--strong)/0.08)] motion-reduce:transform-none motion-reduce:transition-none sm:min-h-[15.75rem] sm:items-center sm:gap-x-6 sm:p-5'>
    <a
      href={`/projects/${project.slug}`}
      class='absolute inset-0 z-20 rounded-2xl outline-none focus-visible:ring-2 focus-visible:ring-primary'
      aria-label={`View project: ${project.title}`}
    ></a>
    <span
      aria-hidden='true'
      class='pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-300 ease-out group-hover:opacity-100 motion-reduce:transition-none'
      style='background:radial-gradient(circle at 15% 20%,hsl(var(--strong)/0.14),transparent 52%),linear-gradient(135deg,hsl(var(--primary)/0.08),transparent 72%)'
    />
    <Image
      src={project.image}
      alt={project.imageAlt}
      widths={[256, 384]}
      sizes='(min-width: 640px) 12rem, 8rem'
      loading='lazy'
      class='relative z-10 aspect-square w-32 shrink-0 rounded-lg border border-border object-cover transition-transform duration-300 ease-out group-hover:scale-[1.02] motion-reduce:transform-none motion-reduce:transition-none sm:w-48'
    />
    <div class='relative z-10 flex min-w-0 flex-col justify-center gap-y-1.5'>
      <h2 id={project.slug} class='flex flex-wrap items-center gap-x-2 font-serif text-lg font-semibold transition-colors duration-300 group-hover:text-primary motion-reduce:transition-none'>
        {project.title}
        {
          project.badge && (
            <span class='rounded-full bg-[hsl(var(--strong)/0.12)] px-2 py-0.5 font-sans text-xs font-medium text-[hsl(var(--strong))]'>
              {project.badge}
            </span>
          )
        }
      </h2>
      {project.paragraphs.map((paragraph) => <p class='text-muted-foreground'>{paragraph}</p>)}
      <div class='relative z-30 mt-2 flex flex-wrap items-center gap-2'>
        {
          project.links.map((link) => (
            <a
              href={link.href}
              target='_blank'
              rel='noopener noreferrer'
              class='inline-flex items-center gap-x-1.5 rounded-lg border border-border bg-background/80 px-3 py-1.5 text-sm font-medium text-muted-foreground shadow-sm transition-colors hover:border-foreground/25 hover:text-foreground'
            >
              <Icon name={link.icon} class='size-4' />
              {link.label}
            </a>
          ))
        }
        <span class='text-sm font-medium text-primary'>View project →</span>
      </div>
    </div>
</article>
