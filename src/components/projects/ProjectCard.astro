---
import type { Project } from '@/data/projects'
import ShowcaseCard from './ShowcaseCard.astro'

interface Props {
  project: Project
}

const { project } = Astro.props
---

<ShowcaseCard
  id={project.slug}
  title={project.title}
  badge={project.badge}
  image={{ src: project.image, alt: project.imageAlt }}
  detail={{ href: `/projects/${project.slug}`, label: 'View project' }}
  links={project.links}
>
  {project.paragraphs.map((paragraph) => <p class='text-muted-foreground'>{paragraph}</p>)}
</ShowcaseCard>
