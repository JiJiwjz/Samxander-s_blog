---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import { Icon } from 'astro-pure/user'

interface Props {
  id: string
  title: string
  heading?: 'h2' | 'h3'
  layout?: 'square' | 'landscape'
  badge?: string
  status?: string
  image?: { src: ImageMetadata; alt: string }
  detail?: { href: string; label: string }
  links: { label: string; icon: 'document' | 'earth' | 'github'; href?: string }[]
}

const { id, title, heading: Heading = 'h2', layout = 'square', badge, status, image, detail, links } = Astro.props
const thumbnailClass = [
  'relative z-10 rounded-lg border border-border transition-transform duration-300 ease-out group-hover:scale-[1.02] motion-reduce:transform-none motion-reduce:transition-none',
  layout === 'landscape' ? 'block h-auto w-full' : 'aspect-square w-32 shrink-0 object-cover sm:w-48'
].join(' ')
const chipClass = 'inline-flex items-center rounded-lg border px-3 py-1.5 text-sm font-medium shadow-sm'
const resourceClass = `${chipClass} pointer-events-auto gap-x-1.5 border-border bg-background/80`
---

<article class:list={[
  'group not-prose relative rounded-2xl border border-border bg-muted/20 p-4 shadow-sm transition-[transform,border-color,box-shadow] duration-300 ease-out hover:-translate-y-0.5 hover:border-[hsl(var(--strong)/0.3)] hover:shadow-lg hover:shadow-[hsl(var(--strong)/0.08)] motion-reduce:transform-none motion-reduce:transition-none sm:p-5',
  status ? 'card-with-status' : 'overflow-hidden',
  layout === 'landscape' ? 'landscape-card' : 'flex gap-x-5 sm:min-h-[15.75rem] sm:items-center sm:gap-x-6'
]}>
  {status && <span class:list={[chipClass, 'card-status absolute z-30 whitespace-nowrap']}>{status}</span>}
  {detail && (
    <a href={detail.href} aria-label={`${detail.label}: ${title}`}
      class='absolute inset-0 z-20 rounded-2xl outline-none focus-visible:ring-2 focus-visible:ring-primary' />
  )}
  <span aria-hidden='true'
    class='pointer-events-none absolute inset-0 rounded-2xl opacity-0 transition-opacity duration-300 ease-out group-hover:opacity-100 motion-reduce:transition-none'
    style='background:radial-gradient(circle at 15% 20%,hsl(var(--strong)/0.14),transparent 52%),linear-gradient(135deg,hsl(var(--primary)/0.08),transparent 72%)' />
  {image ? (
    <Image src={image.src} alt={image.alt} widths={[256, 384]}
      sizes='(min-width: 640px) 12rem, 8rem' loading='lazy' class={thumbnailClass} />
  ) : (
    <div class:list={[thumbnailClass, 'overflow-hidden']}>
      <slot name='cover' />
    </div>
  )}
  <div class:list={['relative z-30 flex min-w-0 flex-col justify-center gap-y-1.5', detail && 'pointer-events-none']}>
    <Heading id={id} class='flex flex-wrap items-center gap-x-2 font-serif text-lg font-semibold transition-colors duration-300 group-hover:text-primary motion-reduce:transition-none'>
      {title}
      {badge && <span class='rounded-full bg-[hsl(var(--strong)/0.12)] px-2 py-0.5 font-sans text-xs font-medium text-[hsl(var(--strong))]'>{badge}</span>}
    </Heading>
    <slot />
    <div class='relative mt-2 flex flex-wrap items-center gap-2'>
      {links.map((link) => link.href ? (
        <a href={link.href} target='_blank' rel='noopener noreferrer'
          class:list={[resourceClass, 'text-muted-foreground transition-colors hover:border-foreground/25 hover:text-foreground']}>
          <Icon name={link.icon} class='size-4' />{link.label}
        </a>
      ) : (
        <span class='resource-pending relative inline-flex'>
          <span role='link' aria-disabled='true' aria-describedby={`${id}-${link.icon}-tip`} tabindex='0'
            class:list={[resourceClass, 'cursor-not-allowed text-neutral-600 dark:text-neutral-400']}>
            <Icon name={link.icon} class='size-4' />{link.label}
          </span>
          <span id={`${id}-${link.icon}-tip`} role='tooltip'
            class='absolute bottom-full left-0 z-10 whitespace-nowrap rounded-md border border-border bg-background px-2 py-1 text-xs text-foreground shadow-sm'>comming soon</span>
        </span>
      ))}
      {detail && <span class='text-sm font-medium text-primary'>{detail.label} →</span>}
    </div>
  </div>
</article>

<style>
  .card-with-status {
    margin-block-start: 1rem;
    padding-block-start: 2rem;
  }
  .card-status {
    top: -1px;
    inset-inline-start: 1rem;
    transform: translateY(-50%);
    color: hsl(var(--strong));
    border-color: hsl(var(--strong) / 0.4);
    background-color: color-mix(in srgb, hsl(var(--strong)) 10%, hsl(var(--background)));
  }
  .landscape-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: 1rem;
  }
  @media (min-width: 640px) {
    .card-status {
      inset-inline-start: 1.25rem;
    }
    .landscape-card {
      grid-template-columns: min(36%, 16rem) minmax(0, 1fr);
      gap: 1.5rem;
    }
  }
  .resource-pending [role='tooltip'] { display: none; }
  .resource-pending:hover [role='tooltip'],
  .resource-pending:focus-within [role='tooltip'] { display: block; }
</style>
