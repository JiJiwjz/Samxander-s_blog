---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'

import { Icon } from 'astro-pure/user'
import SkillLayout from '@/components/home/SkillLayout.astro'

interface SkillGroup {
  title: string
  skills: string[]
}

interface ContactLink {
  label: string
  href: string
  icon: 'github' | 'email' | 'zhihu' | 'coolapk'
}

interface Props {
  avatar: ImageMetadata
  name: string
  subtitle: string
  status?: string
  location: string
  emails: string[]
  contacts: ContactLink[]
  cvUrl?: string
  skills: SkillGroup[]
}

const { avatar, name, subtitle, status, location, emails, contacts, cvUrl, skills } = Astro.props
---

<aside
  id='sidebar'
  class='animate flex flex-col items-center gap-y-5 rounded-3xl border border-[hsl(var(--card-border))] bg-[hsl(var(--card-bg))] p-6 text-[hsl(var(--card-fg))] lg:sticky lg:top-24 lg:items-start lg:self-start'
>
  <Image
    src={avatar}
    alt={name}
    class='h-24 w-auto rounded-full border-2 border-[hsl(var(--card-border))] p-1 lg:h-28'
    loading='eager'
    fetchpriority='high'
  />

  <div class='flex flex-col items-center gap-y-1 lg:items-start'>
    <h1 class='font-serif text-2xl font-semibold'>{name}</h1>
    <p class='text-sm text-[hsl(var(--card-muted))]'>{subtitle}</p>
  </div>

  {
    status && (
      <p class='inline-flex items-start gap-x-2 text-sm text-[hsl(var(--card-muted))]'>
        <span class='relative mt-1.5 flex size-2 shrink-0 items-center justify-center'>
          <span class='absolute size-2 animate-ping rounded-full bg-[hsl(var(--card-link))] opacity-75' />
          <span class='size-1.5 rounded-full bg-[hsl(var(--card-link))]' />
        </span>
        {status}
      </p>
    )
  }

  <span class='inline-flex items-center gap-x-1.5 text-sm text-[hsl(var(--card-muted))]'>
    <Icon name='location' class='size-4' />
    {location}
  </span>

  <div class='flex flex-col items-center gap-y-1 lg:items-start'>
    {
      emails.map((email) => (
        <a
          href={`mailto:${email}`}
          class='inline-flex items-center gap-x-1.5 text-sm text-[hsl(var(--card-muted))] transition-colors'
        >
          <Icon name='email' class='size-4' />
          {email}
        </a>
      ))
    }
  </div>

  <div class='flex flex-wrap items-center gap-2'>
    {
      contacts.map((contact) => (
        <a
          href={contact.href}
          target='_blank'
          rel='noopener noreferrer'
          aria-label={contact.label}
          title={contact.label}
          class='inline-flex size-8 items-center justify-center rounded-full bg-[hsl(var(--card-link)/0.1)] text-[hsl(var(--card-link))] transition-colors hover:bg-[hsl(var(--card-link)/0.18)]'
        >
          <Icon name={contact.icon} class='size-4' />
        </a>
      ))
    }
  </div>

  {
    cvUrl && (
      <button
        id='cv-download-trigger'
        type='button'
        class='inline-flex w-full items-center justify-center gap-x-1.5 rounded-full border border-[hsl(var(--card-link)/0.32)] bg-[hsl(var(--card-link)/0.12)] px-3 py-1.5 text-sm font-medium text-[hsl(var(--card-link))] transition-colors hover:bg-[hsl(var(--card-link)/0.22)] lg:w-auto'
      >
        <Icon name='document' class='size-4' />
        Download CV
      </button>
    )
  }

  <hr class='hidden w-full border-[hsl(var(--card-border))] lg:block' />

  <div class='flex flex-col gap-y-3'>
    {
      skills.map((group) => (
        <SkillLayout title={group.title} skills={group.skills} variant='compact' />
      ))
    }
  </div>
</aside>

{
  cvUrl && (
    <dialog
      id='cv-access-dialog'
      data-cv-url={cvUrl}
      aria-labelledby='cv-dialog-title'
      class='m-auto w-[min(28rem,calc(100%-2rem))] rounded-3xl border border-[hsl(var(--card-border))] bg-[hsl(var(--card-bg))] p-0 text-[hsl(var(--card-fg))] shadow-2xl backdrop:bg-black/65 backdrop:backdrop-blur-sm'
    >
      <form id='cv-access-form' class='flex flex-col gap-y-5 p-6 sm:p-7'>
        <div class='flex items-start justify-between gap-x-4'>
          <div class='space-y-1.5'>
            <p class='text-xs font-medium uppercase tracking-[0.18em] text-[hsl(var(--card-link))]'>
              Verification required
            </p>
            <h2 id='cv-dialog-title' class='font-serif text-2xl font-semibold'>
              Access CV
            </h2>
          </div>
          <button
            id='cv-dialog-close'
            type='button'
            aria-label='Close dialog'
            class='inline-flex size-8 shrink-0 items-center justify-center rounded-full text-xl text-[hsl(var(--card-muted))] transition-colors hover:bg-[hsl(var(--card-link)/0.12)] hover:text-[hsl(var(--card-fg))]'
          >
            &times;
          </button>
        </div>

        <div class='space-y-2'>
          <label for='cv-access-answer' class='block text-sm font-medium'>
            What input format does Jev accept?
          </label>
          <input
            id='cv-access-answer'
            name='answer'
            type='text'
            required
            autocomplete='off'
            spellcheck='false'
            placeholder='Enter your answer'
            class='w-full rounded-xl border border-[hsl(var(--card-border))] bg-[hsl(var(--card-link)/0.06)] px-3.5 py-2.5 text-sm outline-none transition focus:border-[hsl(var(--card-link)/0.65)] focus:ring-2 focus:ring-[hsl(var(--card-link)/0.18)]'
          />
          <p
            id='cv-access-message'
            class='min-h-5 text-sm text-[hsl(var(--card-muted))]'
            aria-live='polite'
          >
            The answer is not case-sensitive.
          </p>
        </div>

        <button
          id='cv-access-submit'
          type='submit'
          class='inline-flex w-full items-center justify-center rounded-full border border-[hsl(var(--card-link)/0.36)] bg-[hsl(var(--card-link)/0.16)] px-4 py-2.5 text-sm font-medium text-[hsl(var(--card-link))] transition-colors hover:bg-[hsl(var(--card-link)/0.26)] disabled:cursor-not-allowed disabled:opacity-60'
        >
          Verify and download
        </button>
      </form>
    </dialog>
  )
}

<script>
  const trigger = document.querySelector<HTMLButtonElement>('#cv-download-trigger')
  const dialog = document.querySelector<HTMLDialogElement>('#cv-access-dialog')
  const form = document.querySelector<HTMLFormElement>('#cv-access-form')
  const closeButton = document.querySelector<HTMLButtonElement>('#cv-dialog-close')
  const input = document.querySelector<HTMLInputElement>('#cv-access-answer')
  const message = document.querySelector<HTMLParagraphElement>('#cv-access-message')
  const submitButton = document.querySelector<HTMLButtonElement>('#cv-access-submit')

  const expectedHash = '02bd175f329720378ce83dd56a1b6b1f5291a60182d6c54b5e0d1e8d248a267a'
  const defaultMessage = 'The answer is not case-sensitive.'
  const maxAttempts = 5
  const cooldownMs = 30_000
  let failedAttempts = 0
  let lockedUntil = 0

  const hashAnswer = async (answer: string) => {
    const bytes = new TextEncoder().encode(answer.trim().toLowerCase())
    const digest = await crypto.subtle.digest('SHA-256', bytes)
    return Array.from(new Uint8Array(digest), (byte) => byte.toString(16).padStart(2, '0')).join('')
  }

  const resetDialog = () => {
    form?.reset()
    if (message) {
      message.textContent = defaultMessage
      message.removeAttribute('data-error')
    }
    if (submitButton) submitButton.disabled = false
  }

  trigger?.addEventListener('click', () => {
    resetDialog()
    dialog?.showModal()
    requestAnimationFrame(() => input?.focus())
  })

  closeButton?.addEventListener('click', () => dialog?.close())

  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close()
  })

  form?.addEventListener('submit', async (event) => {
    event.preventDefault()
    if (!input || !message || !submitButton || !dialog) return

    const now = Date.now()
    if (now < lockedUntil) {
      const seconds = Math.ceil((lockedUntil - now) / 1000)
      message.textContent = `Too many attempts. Please try again in ${seconds} seconds.`
      message.dataset.error = ''
      return
    }

    submitButton.disabled = true
    submitButton.textContent = 'Verifying…'

    const answerHash = await hashAnswer(input.value)
    if (answerHash !== expectedHash) {
      failedAttempts += 1
      if (failedAttempts >= maxAttempts) {
        lockedUntil = Date.now() + cooldownMs
        failedAttempts = 0
        message.textContent = 'Too many attempts. Please try again in 30 seconds.'
      } else {
        message.textContent = `Incorrect answer. ${maxAttempts - failedAttempts} attempts remaining.`
      }
      message.dataset.error = ''
      input.select()
      submitButton.disabled = false
      submitButton.textContent = 'Verify and download'
      return
    }

    failedAttempts = 0
    message.textContent = 'Verified. Your download is starting…'
    message.removeAttribute('data-error')
    const cvUrl = dialog.dataset.cvUrl
    if (cvUrl) {
      const downloadLink = document.createElement('a')
      downloadLink.href = cvUrl
      downloadLink.download = 'Samxander-CV.pdf'
      downloadLink.rel = 'noopener noreferrer'
      document.body.appendChild(downloadLink)
      downloadLink.click()
      downloadLink.remove()
    }
    dialog.close()
    submitButton.disabled = false
    submitButton.textContent = 'Verify and download'
  })
</script>

<style>
  #cv-access-dialog[open] {
    animation: cv-dialog-in 180ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  #cv-access-message[data-error] {
    color: #ef4444;
  }

  @keyframes cv-dialog-in {
    from {
      opacity: 0;
      transform: translateY(10px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #cv-access-dialog[open] {
      animation: none;
    }
  }
</style>
