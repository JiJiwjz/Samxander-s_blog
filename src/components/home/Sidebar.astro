---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import { Icon } from 'astro-pure/user'
import SkillLayout from '@/components/home/SkillLayout.astro'

interface SkillGroup {
  title: string
  skills: string[]
}

interface ContactLink {
  label: string
  href: string
  icon: 'github' | 'email' | 'zhihu' | 'coolapk'
}

interface Props {
  avatar: ImageMetadata
  name: string
  subtitle: string
  status?: string
  location: string
  contacts: ContactLink[]
  cvUrl?: string
  skills: SkillGroup[]
}

const { avatar, name, subtitle, status, location, contacts, cvUrl, skills } = Astro.props
---

<aside
  id='sidebar'
  class='animate flex flex-col items-center gap-y-5 rounded-3xl border border-[hsl(var(--card-border))] bg-[hsl(var(--card-bg))] p-6 text-[hsl(var(--card-fg))] lg:sticky lg:top-24 lg:items-start lg:self-start'
>
  <Image
    src={avatar}
    alt={name}
    class='h-24 w-auto rounded-full border-2 border-[hsl(var(--card-accent)/0.4)] p-1 lg:h-28'
    loading='eager'
    fetchpriority='high'
  />

  <div class='flex flex-col items-center gap-y-1 lg:items-start'>
    <h1 class='font-serif text-2xl font-semibold'>{name}</h1>
    <p class='text-sm text-[hsl(var(--card-muted))]'>{subtitle}</p>
  </div>

  {
    status && (
      <p class='inline-flex items-center gap-x-2 text-sm text-[hsl(var(--card-muted))]'>
        <span class='relative flex size-2 items-center justify-center'>
          <span class='absolute size-2 animate-ping rounded-full bg-[hsl(var(--card-accent))] opacity-75' />
          <span class='size-1.5 rounded-full bg-[hsl(var(--card-accent))]' />
        </span>
        {status}
      </p>
    )
  }

  <span class='inline-flex items-center gap-x-1.5 text-sm text-[hsl(var(--card-muted))]'>
    <Icon name='location' class='size-4' />
    {location}
  </span>

  <div class='flex flex-wrap items-center gap-2'>
    {
      contacts.map((contact) => (
        <a
          href={contact.href}
          target='_blank'
          rel='noopener noreferrer'
          aria-label={contact.label}
          title={contact.label}
          class='inline-flex size-8 items-center justify-center rounded-full bg-[hsl(var(--card-accent)/0.1)] text-[hsl(var(--card-accent))] transition-colors hover:bg-[hsl(var(--card-accent)/0.22)]'
        >
          <Icon name={contact.icon} class='size-4' />
        </a>
      ))
    }
  </div>

  {
    cvUrl && (
      <a
        href={cvUrl}
        target='_blank'
        rel='noopener noreferrer'
        class='inline-flex w-full items-center justify-center gap-x-1.5 rounded-full border border-[hsl(var(--card-accent)/0.32)] bg-[hsl(var(--card-accent)/0.12)] px-3 py-1.5 text-sm font-medium text-[hsl(var(--card-accent))] transition-colors hover:bg-[hsl(var(--card-accent)/0.22)] lg:w-auto'
      >
        <Icon name='document' class='size-4' />
        Download CV
      </a>
    )
  }

  <hr class='hidden w-full border-[hsl(var(--card-border))] lg:block' />

  <div class='flex flex-col gap-y-3'>
    {skills.map((group) => <SkillLayout title={group.title} skills={group.skills} variant='compact' />)}
  </div>
</aside>
