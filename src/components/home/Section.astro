---
import { cn } from 'astro-pure/utils'

interface Props {
  class?: string
  title: string
  /** 'side' = left label + right content (default); 'top' = title above content */
  layout?: 'side' | 'top'
}

const { class: className, title, layout = 'side' } = Astro.props
---

{
  layout === 'top' ? (
    <section class={cn('flex flex-col gap-y-3', className)}>
      <h2 class='text-xl font-medium'>{title}</h2>
      <div class='flex flex-col gap-y-3'>
        <slot />
      </div>
    </section>
  ) : (
    <section class={cn('flex flex-col gap-y-5 md:flex-row md:gap-y-0', className)}>
      <div class='text-xl font-medium md:min-w-36'>
        <h2>{title}</h2>
      </div>
      <div class='flex flex-1 flex-col gap-y-3'>
        <slot />
      </div>
    </section>
  )
}
