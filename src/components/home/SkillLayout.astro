---
import { Button } from 'astro-pure/user'

type Props = {
  title: string
  skills: string[]
  /** 'default' = horizontal label+tags; 'compact' = stacked for narrow sidebar */
  variant?: 'default' | 'compact'
}

const { title, skills, variant = 'default' } = Astro.props
---

{
  variant === 'compact' ? (
    <div class='flex flex-col gap-y-1.5'>
      <h3 class='text-xs font-medium uppercase tracking-wider text-muted-foreground'>{title}</h3>
      <div class='flex flex-row flex-wrap gap-1.5'>
        {skills.map((skill: string) => <Button as='button' title={skill} variant='pill' />)}
      </div>
    </div>
  ) : (
    <div class='flex flex-col gap-y-2 md:flex-row md:gap-x-5 md:gap-y-0'>
      <h3 class='w-1/5 font-medium'>{title}</h3>
      <div class='flex flex-row flex-wrap gap-x-4 gap-y-2 md:w-4/5'>
        {skills.map((skill: string) => <Button as='button' title={skill} variant='pill' />)}
      </div>
    </div>
  )
}
